MONAD_RPC=https://testnet-rpc.monad.xyz
DEPLOYER_KEY=0x...
# comma-separated, team-held testnet keys (SPEC R-1)
REPORTER_KEYS=0x...,0x...
# oracle (python -m oracle); all optional
# ORACLE_CONFIG=oracle/config.toml   # provider address -> node URL
# LOG_CHUNK=1000                     # blocks per eth_getLogs call; lower it if the RPC refuses the range
# ORACLE_API_PORT=8787               # control API port on 127.0.0.1 (docs/UI_HANDOFF.md section 7)
