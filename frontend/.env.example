# Public config only. Never put a private key in the frontend.
# All optional: defaults come from ../shared/deployments/monad-testnet.json and Monad Testnet.
VITE_RPC_URL=https://testnet-rpc.monad.xyz
VITE_EXPLORER_URL=https://testnet.monadscan.com
# Optional Envio HyperIndex GraphQL endpoint. Unset uses direct Monad RPC reads.
# VITE_INDEXER_URL=http://localhost:8080/v1/graphql
# Override the deployed contract (otherwise read from the shared deployment file; null -> mock mode)
# VITE_ESCROW_ADDRESS=0x...
# VITE_DEPLOY_BLOCK=0
# Oracle control API (optional, localhost only; the panel hides itself if unreachable)
VITE_ORACLE_API=http://localhost:8787
# Optional demo address book for the Create form (public addresses only, never keys)
# VITE_DEMO_PROVIDERS=Node A=0x...,Node B=0x...
